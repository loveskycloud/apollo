<package format="2">
  <name>simulation</name>
  <version>local</version>
  <description>Apollo Emulator-LogSim runtime</description>
  <maintainer email="apollo-support@baidu.com">Apollo</maintainer>
  <license>Apache License 2.0</license>
  <type>module</type>
  <src_path url="https://github.com/ApolloAuto/apollo">//modules/simulation</src_path>
  <depend repo_name="cyber" lib_names="cyber">cyber</depend>
  <depend>common</depend>
  <depend>common-msgs</depend>
  <depend>map</depend>
  <depend>transform</depend>
  <depend>localization</depend>
  <depend>perception-pointcloud-preprocess</depend>
  <depend>perception-pointcloud-map-based-roi</depend>
  <depend>perception-pointcloud-ground-detection</depend>
  <depend>perception-lidar-detection</depend>
  <depend>perception-lidar-detection-filter</depend>
  <depend>perception-lidar-tracking</depend>
  <depend>perception-lidar-output</depend>
  <!-- Restore together with ML Planning custom command support.
  <depend>external-command-proto</depend>
  -->
  <depend repo_name="com_github_gflags_gflags" lib_names="gflags">3rd-gflags</depend>
  <depend repo_name="com_google_protobuf" lib_names="protobuf">3rd-protobuf</depend>
  <depend expose="False">3rd-rules-proto</depend>
  <depend repo_name="com_google_googletest" lib_names="gtest,gtest_main">3rd-gtest</depend>
</package>
